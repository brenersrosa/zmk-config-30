/* boards/shields/unido/unido.overlay — teclado unido 30 teclas, matriz ÚNICA 4 linhas x 8 colunas, 1 ProMicro nRF52840
   linhas compartilhadas pelas duas mãos; C0..C3 = esquerda (de fora p/ dentro), C4..C7 = direita (de dentro p/ fora)
   polegares: LT1=C3 LT2=C2 LT3=C1 | RT1=C4 RT2=C5 RT3=C6  (todos na linha R3)
   pinos livres: 104 106 009 031 029 002 (031/029/002 são analógicos) */
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7)
                        RC(3,3) RC(3,2) RC(3,1)   RC(3,6) RC(3,5) RC(3,4)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* 022 R0 */
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* 024 R1 */
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* 100 R2 */
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* 011 R3 (polegares) */
            ;
        col-gpios
            = <&pro_micro 1 GPIO_ACTIVE_HIGH>    /* 006 C0 */
            , <&pro_micro 0 GPIO_ACTIVE_HIGH>    /* 008 C1 */
            , <&pro_micro 2 GPIO_ACTIVE_HIGH>    /* 017 C2 */
            , <&pro_micro 3 GPIO_ACTIVE_HIGH>    /* 020 C3 */
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>   /* 010 C4 */
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>   /* 111 C5 */
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>   /* 113 C6 */
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>   /* 115 C7 */
            ;
    };
};
